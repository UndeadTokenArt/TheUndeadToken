<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{.FirstName}} {{.LastName}} | {{.JobTitle}}</title>
    <link rel="stylesheet" href="/static/css/homepageStyle.css">
    <script src="/static/js/homepageScript.js"></script>
</head>

<body class="parchment text-dark rustic-body">
    <button id="sidebar-toggle" class="rustic-toggle" aria-label="Toggle sidebar">Menu</button>
    <div id="sidebar-overlay" class="rustic-overlay"></div>

    <aside id="site-sidebar" class="rustic-sidebar">
        <div>
            <h1 class="rustic-brand">{{.FirstName}} <span>{{.LastName}}</span></h1>
            <p class="rustic-subtitle">{{.JobTitle}}</p>
            <p class="rustic-small">{{.Tagline}}</p>
        </div>
        <nav class="rustic-nav">
            {{range .NavItems}}
            <a href="{{.Href}}" class="rustic-nav-link">{{.Text}}</a>
            {{end}}
        </nav>
        <div class="rustic-sidebar-footer">
            <p class="rustic-small">{{.Location}}</p>
            <a href="mailto:{{.Email}}" class="rustic-link">{{.Email}}</a>
        </div>
    </aside>

    <main id="site-main" class="rustic-main">
        <section id="home" class="rustic-panel rustic-hero">
            <div>
                <p class="rustic-kicker">Builder / Creator</p>
                <h2 class="rustic-hero-title">{{.FirstName}} <span class="gradient-text">{{.LastName}}</span></h2>
                <p class="rustic-intro">{{.HeroDescription}}</p>
                <div class="rustic-actions">
                    <a href="#projects" class="rustic-button">View My Work</a>
                    <a href="#contact" class="rustic-button rustic-button-ghost">Contact Me</a>
                </div>
            </div>
            <div class="rustic-avatar-wrap">
                <div class="rustic-avatar-frame">
                    <img src="{{.ProfileImage}}" alt="{{.FirstName}} {{.LastName}}" class="rustic-avatar-image">
                </div>
            </div>
        </section>

        <section id="projects" class="rustic-panel">
            <div class="rustic-section-head">
                <h3 class="rustic-section-title">Projects</h3>
                <p class="rustic-small">Work built with practical curiosity and craft.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {{range .Projects}}
                <article class="rustic-card project-card">
                    <a href="{{.ProjectURL}}" class="rustic-card-media">
                        <img src="{{.Image}}" alt="{{.Title}}" class="w-full h-full object-cover">
                    </a>
                    <div class="p-6">
                        <h4 class="text-xl font-bold mb-3">{{.Title}}</h4>
                        <p class="rustic-small mb-4">{{.Description}}</p>
                        <p class="rustic-tech mb-4">{{range $i, $tech := .Technologies}}{{if $i}} • {{end}}{{$tech}}{{end}}</p>
                        <div class="flex justify-between items-center">
                            {{if .ProjectURL}}
                            <a href="{{.ProjectURL}}" class="rustic-link">View Project</a>
                            {{end}}
                            <div class="flex space-x-2">
                                {{if .GithubURL}}
                                <a href="{{.GithubURL}}" class="rustic-icon-link">GitHub</a>
                                {{end}}
                                {{if .LiveURL}}
                                <a href="{{.LiveURL}}" class="rustic-icon-link">Live</a>
                                {{end}}
                            </div>
                        </div>
                    </div>
                </article>
                {{end}}
            </div>
        </section>

        <section id="about" class="rustic-panel">
            <div class="rustic-section-head">
                <h3 class="rustic-section-title">{{.AboutTitle}}</h3>
                <p class="rustic-small">{{.AboutIntro}}</p>
            </div>
            <div class="flex flex-col md:flex-row gap-10">
                <div class="md:w-1/2">
                    {{range .AboutParagraphs}}
                    <p class="rustic-body-copy">{{.}}</p>
                    {{end}}
                </div>
                <div class="md:w-1/2">
                    <div class="rustic-card p-6 mb-8">
                        <h4 class="text-xl font-semibold mb-4">Skills</h4>
                        <div class="flex flex-wrap gap-3">
                            {{range .Skills}}
                            <span class="rustic-chip">{{.}}</span>
                            {{end}}
                        </div>
                    </div>
                    <div class="rustic-card p-6">
                        <h4 class="text-xl font-semibold mb-4">Experience</h4>
                        <div class="space-y-6">
                            {{range .Experience}}
                            <div class="rustic-timeline-item">
                                <h5 class="font-medium text-lg">{{.Title}}</h5>
                                <p class="rustic-small">{{.Company}} • {{.Year}}</p>
                                <p class="rustic-small">{{.Description}}</p>
                            </div>
                            {{end}}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="contact" class="rustic-panel">
            <div class="rustic-section-head">
                <h3 class="rustic-section-title">Get In Touch</h3>
                <p class="rustic-small">Have a project in mind or want to discuss opportunities?</p>
            </div>
            <div class="rustic-card p-8">
                <p class="rustic-body-copy"><strong>Email:</strong> <a href="mailto:{{.Email}}" class="rustic-link">{{.Email}}</a></p>
                <p class="rustic-body-copy"><strong>Location:</strong> {{.Location}}</p>
                <div class="rustic-actions">
                    <a href="{{.SocialLinks.Github}}" class="rustic-button rustic-button-ghost">GitHub</a>
                    <a href="{{.SocialLinks.LinkedIn}}" class="rustic-button rustic-button-ghost">LinkedIn</a>
                </div>
            </div>
        </section>

        <footer class="rustic-footer">
            <p>UndeadToken</p>
            <p>© 2026 Stephen Moore. All rights reserved.</p>
        </footer>
    </main>
</body>

</html>